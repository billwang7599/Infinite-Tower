# Settings for running the game locally. Copy this file to .env and change what you need there; .env is
# git-ignored, this file isn't. `npm run dev` (through `npm run db:up`) makes the copy if .env is missing.
# Variables already set in your shell win over .env.

# The dev database (compose.yaml): Docker uses these when it first creates it. Changing the user, password or
# database afterwards means wiping it with `npm run db:reset`; the port can change any time (`npm run db:up`).
POSTGRES_USER=infinite_tower
POSTGRES_PASSWORD=infinite_tower
POSTGRES_DB=infinite_tower
POSTGRES_PORT=5433

# What the game server connects to. In dev it has to match the four lines above (127.0.0.1, not localhost:
# the container only listens on IPv4). Production sets this to its own Postgres instead.
DATABASE_URL=postgres://infinite_tower:infinite_tower@127.0.0.1:5433/infinite_tower

# The game server's port. The Vite dev server reads it too, to proxy /ws there.
PORT=8787

# This game server's entry in the title screen's server list, and how many players it lets on at once (past that,
# a new player is refused with "full"). "Local" and 50 if left out.
SERVER_NAME=Local
MAX_PLAYERS=50

# Whether every request comes through Cloudflare, so the login limit counts each visitor by Cloudflare's
# CF-Connecting-IP header rather than the connection's address. compose.prod.yaml turns it on. Leave it false
# wherever the server can be reached directly, since anyone could fake the header there.
BEHIND_CLOUDFLARE=false

# Dev only: the network round trip (ms) the dev server simulates on the game's socket, half each way, so client
# prediction can be felt on localhost. Any whole number of ms, 0 for none; 50 if left out. A page can ask for its
# own with ?ping=N in its address. Production ignores it and never delays.
DEV_PING_MS=50

# The admin panel's cheats (F1, the chat's /commands): only with CHEATS=1, else the server ignores them. Never set
# it on a public server; compose.prod.yaml doesn't pass it.
CHEATS=1

# Where the art lab (`npm run art`) saves drawings, each as a .json to reopen and a .png: relative to the repo root,
# or absolute (~ works). A lab run from another copy of the repo can point it at your main checkout's art-lab/files.
ART_LAB_FILES_DIR=art-lab/files

# Hosting (compose.prod.yaml, README's "Hosting") reads only POSTGRES_USER, _PASSWORD and _DB, SERVER_NAME and
# MAX_PLAYERS from .env. There, make POSTGRES_PASSWORD long and random, in letters and digits only since it goes
# into the database's address (`openssl rand -hex 32`).
